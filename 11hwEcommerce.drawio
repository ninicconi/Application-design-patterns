        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!theme plain\n\nabstract class User {\n  -int ID\n  -string name\n  -string email\n  -string address\n  -string phone\n  +register()\n  +login()\n  +updateData()\n}\n\nclass Customer {\n  -int loyaltyPoints\n  +viewHistory()\n  +addReview()\n}\n\nclass Administrator {\n  -string adminLevel\n  +manageUsers()\n  +viewSystemLogs()\n}\n\nclass Product {\n  -int productID\n  -string name\n  -string description\n  -double price\n  -int stockQuantity\n  +create()\n  +update()\n  +delete()\n  +checkAvailability()\n}\n\nclass Category {\n  -int categoryID\n  -string name\n  +addProduct()\n}\n\nclass Order {\n  -int orderID\n  -Date createDate\n  -string status\n  -double totalAmount\n  -string promoCode\n  +placeOrder()\n  +cancelOrder()\n  +calcTotal()\n}\n\nclass OrderItem {\n  -int quantity\n  -double priceAtPurchase\n  +calculateSubtotal()\n}\n\nclass Payment {\n  -int paymentID\n  -string type\n  -double amount\n  -Date paymentDate\n  -string status\n  +process()\n  +refund()\n}\n\nclass Delivery {\n  -int deliveryID\n  -string address\n  -string deliveryStatus\n  -string courierName\n  +send()\n  +track()\n  +complete()\n}\n\nclass Review {\n  -int reviewID\n  -int rating\n  -string comment\n  +postReview()\n}\n\nUser &lt;|-- Customer\nUser &lt;|-- Administrator\nCategory \&quot;1\&quot; -- \&quot;0..*\&quot; Product\nCustomer \&quot;1\&quot; -- \&quot;0..*\&quot; Order\nOrder \&quot;1\&quot; *-- \&quot;1..*\&quot; OrderItem\nProduct \&quot;1\&quot; -- \&quot;0..*\&quot; OrderItem\nOrder \&quot;1\&quot; -- \&quot;1\&quot; Payment\nOrder \&quot;1\&quot; -- \&quot;1\&quot; Delivery\nProduct \&quot;1\&quot; -- \&quot;0..*\&quot; Review\nCustomer \&quot;1\&quot; -- \&quot;0..*\&quot; Review\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="o4ZtfH7mAKWPMvHgnyqq-0">
