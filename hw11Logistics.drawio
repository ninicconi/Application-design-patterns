        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam componentStyle uml2\n\npackage \&quot;Frontend Clients\&quot; {\n    component \&quot;Web Application\&quot; as WebApp\n    component \&quot;Mobile App (Couriers)\&quot; as MobileApp\n}\n\npackage \&quot;Backend Infrastructure\&quot; {\n    component \&quot;API Gateway\&quot; as Gateway\n    component \&quot;Backend Core Logic\&quot; as Backend\n    component \&quot;Route Optimizer\&quot; as Optimizer\n    component \&quot;Warehouse Module\&quot; as Warehouse\n    component \&quot;Notification Service\&quot; as Notify\n    component \&quot;Analytics Service\&quot; as Analytics\n}\n\ndatabase \&quot;Main Database\&quot; as DB\n\npackage \&quot;External Integrations\&quot; {\n    component \&quot;External Courier APIs\&quot; as ExtCourier\n    component \&quot;Payment Gateway\&quot; as ExtPay\n}\n\n&#39; Relationships between components\nWebApp ..&gt; Gateway : REST API\nMobileApp ..&gt; Gateway : REST API\n\nGateway -&gt; Backend : HTTP/JSON\n\nBackend --&gt; DB : Read/Write Data\nBackend --&gt; Optimizer : Request Route Calc\nBackend --&gt; Warehouse : Update Inventory\nBackend --&gt; Notify : Send Alerts\nBackend --&gt; Analytics : Log Performance\n\n&#39; Interactions with external systems\nBackend ..&gt; ExtCourier : Webhooks / API\nBackend ..&gt; ExtPay : Secure Transaction\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="DpqTQk4LSdNyoQzyIDuZ-1">
