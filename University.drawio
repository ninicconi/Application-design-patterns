<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/142.0.0.0 Safari/537.36 Edg/142.0.0.0" version="29.2.3">
  <diagram name="Page-1" id="ezMMUL5uInuIVOVtCnuD">
    <mxGraphModel dx="1411" dy="1917" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!theme plain\nhide circle\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\n\n&#39; 1. Abstract Base Class\nabstract class User {\n    # int ID\n    # string FullName\n    # string Email\n    # string Phone\n    + Login()\n    + Logout()\n}\n\n&#39; 2. Main Actors\nclass Administrator {\n    + CreateFaculty()\n    + CreateDepartment()\n    + ManageUsers()\n}\n\nclass Teacher {\n    - string Position\n    - List&lt;Course&gt; Courses\n    + TeachClass()\n    + SetGrade(Student s, int grade)\n    + ViewSchedule()\n}\n\nclass Student {\n    - int StudentID\n    - List&lt;Course&gt; EnrolledCourses\n    - double GPA\n    + RegisterForCourse()\n    + TakeExam()\n    + ViewGrades()\n}\n\n&#39; 3. University Structure\nclass University {\n    - string Name\n    - string Address\n    + AddFaculty()\n    + RemoveFaculty()\n}\n\nclass Faculty {\n    - string Name\n    - string DeanName\n    + AddDepartment()\n}\n\nclass Department {\n    - string Name\n    + AddTeacher()\n    + AddCourse()\n}\n\n&#39; 4. Education Entities\nclass Course {\n    - string CourseCode\n    - string Title\n    - int Credits\n    + AddStudent()\n    + GetSyllabus()\n}\n\nclass Schedule {\n    - DateTime Time\n    - string RoomNumber\n    + CreateSchedule()\n    + UpdateSchedule()\n}\n\nclass Exam {\n    - DateTime Date\n    - string Type\n    + ScheduleExam()\n    + GradeExam()\n}\n\nclass Grade {\n    - int Score\n    - string LetterGrade\n    - DateTime Date\n}\n\n&#39; 5. Extra Entities (Additional Task)\nclass Scholarship {\n    - double Amount\n    - string Criteria\n    + CheckEligibility(Student s)\n}\n\nclass ScientificProject {\n    - string Topic\n    - double Budget\n    + AssignStudent()\n}\n\n&#39; Inheritance\nUser &lt;|-- Administrator\nUser &lt;|-- Teacher\nUser &lt;|-- Student\n\n&#39; Relationships\nUniversity \&quot;1\&quot; *-- \&quot;1..*\&quot; Faculty : Composition\nFaculty \&quot;1\&quot; *-- \&quot;1..*\&quot; Department : Composition\nDepartment \&quot;1\&quot; o-- \&quot;*\&quot; Teacher : Aggregation\nDepartment \&quot;1\&quot; -- \&quot;*\&quot; Course : Manages &gt;\n\nTeacher \&quot;1..*\&quot; -- \&quot;*\&quot; Course : Teaches &gt;\nStudent \&quot;*\&quot; -- \&quot;*\&quot; Course : Enrolls &gt;\n\nCourse \&quot;1\&quot; -- \&quot;1\&quot; Schedule : Has &gt;\nCourse \&quot;1\&quot; -- \&quot;*\&quot; Exam : Includes &gt;\nExam \&quot;1\&quot; -- \&quot;*\&quot; Grade : Generates &gt;\nStudent \&quot;1\&quot; -- \&quot;*\&quot; Grade : Receives &gt;\n\n&#39; Extra Relationships\nDepartment \&quot;1\&quot; -- \&quot;*\&quot; ScientificProject : Hosts &gt;\nStudent \&quot;0..*\&quot; -- \&quot;0..1\&quot; Scholarship : Receives &gt;\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="z6Ks3LU91l0a_7Y1zvIv-1">
