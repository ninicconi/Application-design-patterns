        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!theme plain\nautonumber\n\nactor Client\nparticipant System\nparticipant \&quot;Payment Gateway\&quot; as Gateway\nactor \&quot;Venue Admin\&quot; as Admin\nactor Contractor\nactor Manager\n\nClient -&gt; System: Request Venue Availability\nactivate System\n\nalt Venue Unavailable\n    System --&gt; Client: Suggest different dates/venue\nelse Venue Available\n    System --&gt; Client: Show Price &amp; Conditions\n    \n    Client -&gt; System: Confirm Booking\n    System -&gt; Gateway: Request Pre-payment\n    activate Gateway\n    \n    alt Payment Failed\n        Gateway --&gt; System: Transaction Declined\n        System --&gt; Client: Notification: Payment Failed, Retry\n    else Payment Successful\n        Gateway --&gt; System: Transaction Approved\n        deactivate Gateway\n        \n        System --&gt; Client: Booking Confirmed\n        System --&gt; Admin: New Booking Notification\n        \n        Admin -&gt; System: Create Task List (Decor, Food)\n        \n        par Notify Contractors\n            System -&gt; Contractor: Notify Task: Decor\n        else\n            System -&gt; Contractor: Notify Task: Catering\n        end\n        \n        Contractor --&gt; System: Confirm Task Completion\n        System --&gt; Admin: Send Completion Report\n        \n        note over Client, System: Event Takes Place\n        \n        System -&gt; Client: Request Feedback\n        Client -&gt; System: Submit Feedback\n        System -&gt; Manager: Send Performance Report\n    end\nend\ndeactivate System\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="xZYBb_Lwwb5bbOiI9DoK-3">
