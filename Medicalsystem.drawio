        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!theme plain\nhide circle\nskinparam classAttributeIconSize 0\n\nabstract class User {\n    # int ID\n    # string Name\n    # string Address\n    + login()\n    + logout()\n}\n\nclass Patient {\n    - Date DateOfBirth\n    - string History\n    + makeAppointment()\n    + updateData()\n    + viewHistory()\n}\n\nclass Doctor {\n    - string Specialization\n    - string Schedule\n    - int RoomNumber\n    + prescribeTreatment()\n    + issuePrescription()\n    + updateSchedule()\n}\n\nclass Appointment {\n    - int ID\n    - Date Date\n    - Time Time\n    - string Status\n    + create()\n    + cancel()\n    + complete()\n}\n\nclass MedicalRecord {\n    - int ID\n    - List testResults\n    - List diagnoses\n    + addEntry()\n    + updateDiagnosis()\n    + removeEntry()\n}\n\nclass Prescription {\n    - int ID\n    - string Dosage\n    - Date ExpiryDate\n    + create()\n    + update()\n    + void()\n}\n\nclass Medicine {\n    - int ID\n    - string Name\n    - int Quantity\n    - Date ExpiryDate\n    + order()\n    + issue()\n    + writeOff()\n}\n\n&#39; Inheritance\nUser &lt;|-- Patient\nUser &lt;|-- Doctor\n\n&#39; Relationships\nPatient \&quot;1\&quot; -- \&quot;*\&quot; Appointment : requests &gt;\nDoctor \&quot;1\&quot; -- \&quot;*\&quot; Appointment : conducts &gt;\nPatient \&quot;1\&quot; *-- \&quot;1\&quot; MedicalRecord : owns\nMedicalRecord \&quot;1\&quot; -- \&quot;*\&quot; Appointment : logs &gt;\nDoctor ..&gt; Prescription : creates &gt;\nPrescription \&quot;*\&quot; -- \&quot;1..*\&quot; Medicine : contains &gt;\nPatient \&quot;1\&quot; -- \&quot;*\&quot; Prescription : receives &gt;\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="Hf3SLTyviHp3KdgC1f3T-1">
