        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!theme plain\nskinparam componentStyle uml2\n\npackage \&quot;Logistics System Core\&quot; {\n    component \&quot;User Management\&quot; as UserMod\n    component \&quot;Order Management\&quot; as OrderMod\n    component \&quot;Route Planning\&quot; as RouteMod\n    component \&quot;Transport Monitoring\&quot; as MonitorMod\n    component \&quot;Payment Management\&quot; as PayMod\n    component \&quot;Notification Module\&quot; as NotifyMod\n}\n\npackage \&quot;External Systems\&quot; {\n    component \&quot;Google Maps API\&quot; as ExtMaps\n    component \&quot;Payment Gateway API\&quot; as ExtBank\n    component \&quot;GPS Satellite System\&quot; as ExtGPS\n    component \&quot;SMS/Email Gateway\&quot; as ExtMsg\n}\n\n&#39; Interfaces\ninterface \&quot;UserAPI\&quot; as IUser\ninterface \&quot;OrderAPI\&quot; as IOrder\ninterface \&quot;RouteAPI\&quot; as IRoute\ninterface \&quot;MonitorAPI\&quot; as IMonitor\n\n&#39; Component to Interface links\nUserMod -down- IUser\nOrderMod -down- IOrder\nRouteMod -down- IRoute\nMonitorMod -down- IMonitor\n\n&#39; Internal Dependencies\nOrderMod ..&gt; IUser : Verify User\nOrderMod ..&gt; IRoute : Calc Distance\nOrderMod ..&gt; IMonitor : Track Driver\nOrderMod ..&gt; NotifyMod : Send Updates\n\n&#39; External Dependencies\nRouteMod ..&gt; ExtMaps : HTTP/JSON\nPayMod ..&gt; ExtBank : Secure HTTPS\nMonitorMod ..&gt; ExtGPS : Telemetry Data\nNotifyMod ..&gt; ExtMsg : SMTP/SMPP\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="cywrghjFmbF7zV4G5xm2-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
