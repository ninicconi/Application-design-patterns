        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!theme plain\nleft to right direction\n\nactor \&quot;Student\&quot; as Student\nactor \&quot;Teacher\&quot; as Teacher\nactor \&quot;Administrator\&quot; as Admin\n\n&#39; Inheritance: Teacher and Admin can do what Student does\nStudent &lt;|-- Teacher\nStudent &lt;|-- Admin\n\nrectangle \&quot;Online Course System\&quot; {\n    \n    &#39; Student Use Cases\n    usecase \&quot;Register\&quot; as UC_Reg\n    usecase \&quot;Login\&quot; as UC_Login\n    usecase \&quot;Verify Email\&quot; as UC_Verify\n    usecase \&quot;View Courses\&quot; as UC_View\n    usecase \&quot;Enroll in Course\&quot; as UC_Enroll\n    usecase \&quot;Take Test\&quot; as UC_Test\n    usecase \&quot;Leave Review\&quot; as UC_Review\n\n    &#39; Teacher Use Cases\n    usecase \&quot;Create/Edit Course\&quot; as UC_ManageCourse\n    usecase \&quot;Add Materials\&quot; as UC_Materials\n    usecase \&quot;Create Tests\&quot; as UC_CreateTest\n    usecase \&quot;View Statistics\&quot; as UC_Stats\n    usecase \&quot;Moderate Reviews\&quot; as UC_ModReview\n\n    &#39; Admin Use Cases\n    usecase \&quot;Manage Users\&quot; as UC_ManageUsers\n    usecase \&quot;Manage Categories\&quot; as UC_Cats\n    usecase \&quot;View Analytics\&quot; as UC_Analytics\n\n    &#39; Relationships\n    Student --&gt; UC_Reg\n    Student --&gt; UC_Login\n    Student --&gt; UC_View\n    Student --&gt; UC_Enroll\n    Student --&gt; UC_Test\n    Student --&gt; UC_Review\n\n    Teacher --&gt; UC_ManageCourse\n    Teacher --&gt; UC_Materials\n    Teacher --&gt; UC_CreateTest\n    Teacher --&gt; UC_Stats\n    Teacher --&gt; UC_ModReview\n\n    Admin --&gt; UC_ManageUsers\n    Admin --&gt; UC_Cats\n    Admin --&gt; UC_Analytics\n\n    &#39; Includes and Extends\n    UC_Reg ..&gt; UC_Verify : &lt;&lt;include&gt;&gt;\n    UC_ManageCourse ..&gt; UC_Materials : &lt;&lt;extend&gt;&gt;\n    UC_ManageCourse ..&gt; UC_CreateTest : &lt;&lt;include&gt;&gt;\n}\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="oUXtpKEBWvu6j_atDfQ_-1">
