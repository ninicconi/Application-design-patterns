<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/142.0.0.0 Safari/537.36 Edg/142.0.0.0" version="29.2.3">
  <diagram name="Page-1" id="Cj_4y1EQeZTurK5PrQXx">
    <mxGraphModel dx="988" dy="572" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!theme plain\nautonumber\n\nactor User\nparticipant System\nparticipant \&quot;Payment Gateway\&quot; as Gateway\ndatabase \&quot;Database\&quot; as DB\n\n== Phase 1: Registration ==\nUser -&gt; System: Select Course\nactivate System\nSystem -&gt; DB: Check Course Availability\nactivate DB\nDB --&gt; System: Return Status\ndeactivate DB\n\nalt Course Unavailable\n    System --&gt; User: Notify: Course Full/Closed\nelse Course Available\n    System -&gt; DB: Add User to Temp List\n    \n    == Phase 2: Payment ==\n    User -&gt; System: Select Payment (Online)\n    System -&gt; Gateway: Process Payment\n    activate Gateway\n    \n    alt Payment Rejected\n        Gateway --&gt; System: Error/Insufficient Funds\n        System --&gt; User: Notify: Retry Payment\n    else Payment Successful\n        Gateway --&gt; System: Success Token\n        deactivate Gateway\n        \n        System -&gt; DB: Activate Course Access\n        System --&gt; User: Access Granted\n        \n        == Phase 3: Learning ==\n        User -&gt; System: Start Learning Modules\n        loop Every Module\n            User -&gt; System: Submit Assignment/Test\n            System -&gt; DB: Save Progress\n        end\n        \n        == Phase 4: Completion ==\n        System -&gt; System: Calculate Final Score\n        \n        alt Score &lt; Passing Grade\n            System --&gt; User: Notify: Retake Tests\n        else Score &gt;= Passing Grade\n            par Parallel Completion Actions\n                System -&gt; User: Issue Certificate\n            else\n                System -&gt; DB: Archive \&quot;Completed\&quot; Status\n            end\n            \n            User -&gt; System: Download Certificate\n        end\n    end\nend\ndeactivate System\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="edgb8__9y_9SbFu5usZC-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="1112" width="679" x="10" y="150" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
