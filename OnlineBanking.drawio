        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!theme plain\nskinparam componentStyle uml2\n\npackage \&quot;Client Layer (Frontend)\&quot; {\n    component \&quot;Web Application\&quot; as WebApp\n    component \&quot;Mobile Application\&quot; as MobApp\n}\n\npackage \&quot;Banking Backend System\&quot; {\n    component \&quot;API Gateway\&quot; as Gateway\n    component \&quot;Core Banking Logic\&quot; as Backend\n    component \&quot;Auth Service\&quot; as Auth\n    component \&quot;Notification System\&quot; as Notify\n    component \&quot;Analytics Module\&quot; as Analytics\n    component \&quot;System Monitoring\&quot; as Monitor\n}\n\ndatabase \&quot;Banking Database\&quot; as DB\n\npackage \&quot;External Integrations\&quot; {\n    component \&quot;Payment Gateway\&quot; as ExtPay\n    component \&quot;SMS/Email Provider\&quot; as ExtMsg\n    component \&quot;Social Media API\&quot; as Social\n}\n\n&#39; Interfaces\ninterface \&quot;REST API\&quot; as IRest\ninterface \&quot;Auth API\&quot; as IAuth\ninterface \&quot;SQL\&quot; as ISQL\n\n&#39; Connections\nWebApp -down-&gt; IRest\nMobApp -down-&gt; IRest\nIRest -down- Gateway\n\nGateway -down-&gt; Backend\nBackend -right-&gt; IAuth\nIAuth -right- Auth\n\nBackend -down-&gt; ISQL\nISQL -down- DB\n\n&#39; Internal Dependencies\nBackend ..&gt; Notify : Trigger Alert\nBackend ..&gt; Analytics : Send Data\nMonitor ..&gt; Backend : Health Check\n\n&#39; External Dependencies\nBackend ..&gt; ExtPay : Process Transfer\nNotify ..&gt; ExtMsg : Send OTP\nAuth ..&gt; Social : Social Login\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="rjZpRoisL9A9TkSquKTf-1">
