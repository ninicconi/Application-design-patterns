        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n!theme plain\n\n|Client|\nstart\n:Create Order;\n\n|System|\n:Check Stock Availability;\nif (All Items In Stock?) then (No)\n    :Notify: Modify Order;\n    |Client|\n    :Modify or Cancel;\n    stop\nelse (Yes)\n    |System|\n    :Confirm Order;\nendif\n\n|Client|\n:Select Payment Method;\nif (Method?) then (Online Payment)\n    |System|\n    :Request Payment;\n    |Payment Gateway|\n    :Process Transaction;\n    if (Success?) then (No)\n        |System|\n        :Notify: Payment Failed;\n        stop\n    else (Yes)\n    endif\nelse (Pay on Delivery)\nendif\n\n|System|\n:Send Order to Warehouse;\n\n|Warehouse|\nfork\n    :Assemble Order;\nfork again\n    |System|\n    :Update Status: \&quot;Assembling\&quot;;\nend fork\n\nif (Delivery Method?) then (Courier)\n    |System|\n    :Send Request to Courier Service;\n    |Courier Service|\n    :Pick up Package;\n    :Deliver to Client;\n    |Client|\n    :Confirm Receipt;\nelse (Pickup)\n    |System|\n    :Notify: Ready for Pickup;\n    |Client|\n    :Pick up Order;\nendif\n\n|System|\n:Finalize Order;\n:Send Electronic Receipt;\nstop\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="rIHW8r_w6b3rJDte6w7G-1">
